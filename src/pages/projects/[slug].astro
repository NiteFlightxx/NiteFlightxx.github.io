---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import { SITE } from '../../consts';
import { knowledgeCategoryZh, knowledgeSubtopicZh } from '../../lib/taxonomy';
import type { ArticleTopicRole } from '../../types';
import '../../index.css';

type TopicEntry = CollectionEntry<'topics'>;
type KnowledgeEntry = CollectionEntry<'knowledge'>;

interface Props {
  topic: TopicEntry;
  articles: KnowledgeEntry[];
}

export async function getStaticPaths() {
  const [topics, knowledge] = await Promise.all([
    getCollection('topics'),
    getCollection('knowledge', (entry) => !entry.data.draft),
  ]);

  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: {
      topic,
      articles: knowledge.filter((article) =>
        article.data.topics.some((ref) => ref.id === topic.slug),
      ),
    },
  }));
}

const { topic, articles } = Astro.props as Props;
const { Content } = await render(topic);
const baseURL = import.meta.env.BASE_URL;

const roleLabels: Record<ArticleTopicRole, string> = {
  theory: '理论基础',
  source: '源码解析',
  algorithm: '通用算法',
  comparison: '引擎对比',
  practice: '工程实践',
  experiment: '实验验证',
};

function formatZhDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
}

function topicRef(article: KnowledgeEntry) {
  return article.data.topics.find((ref) => ref.id === topic.slug);
}

const stages = [...topic.data.stages].sort((a, b) => a.order - b.order);
const stageOrder = new Map(stages.map((stage) => [stage.id, stage.order]));
const sortedArticles = [...articles].sort((a, b) => {
  const refA = topicRef(a);
  const refB = topicRef(b);
  return (stageOrder.get(refA?.stage ?? '') ?? 0) - (stageOrder.get(refB?.stage ?? '') ?? 0)
    || (refA?.order ?? 0) - (refB?.order ?? 0);
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <BaseHead
      title={`${topic.data.title} · ${SITE.shortTitle}`}
      description={topic.data.excerpt}
      type="article"
      canonicalPath={Astro.url.pathname}
    />
  </head>
  <body class="bg-surface-base text-text-secondary">
    <div class="fixed inset-0 -z-20 bg-surface-base"></div>
    <div class="grain-overlay" aria-hidden="true"></div>

    <header class="sticky top-0 z-50 glass-panel border-b border-border-subtle px-6 md:px-12 py-3.5 flex items-center justify-between select-none">
      <a href={`${baseURL}#projects`} class="flex items-center gap-2 font-display font-black text-base tracking-widest text-text-primary hover:text-accent-primary transition-colors">
        <svg class="w-5 h-5" viewBox="132 92 284 296" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M150 150L170 170L170 350L150 370Z"/>
          <path transform="translate(10, 0)" d="M340 120L360 100L360 300L340 280Z"/>
          <path d="M140 110 C200 120,250 180,300 260 C330 305,365 340,400 355 C360 350,315 320,265 250 C220 185,195 135,140 110 Z"/>
        </svg>
        NITE
      </a>
      <a href={`${baseURL}#projects`} class="text-xs font-mono text-text-muted hover:text-text-primary transition-colors">返回项目</a>
    </header>

    <main class="w-full max-w-5xl mx-auto px-6 md:px-8 py-12 md:py-20 space-y-14">
      <section class="space-y-6">
        <div class="flex flex-wrap items-center gap-2 text-[10px] font-mono uppercase tracking-widest">
          <span class="text-accent-primary">专题研究</span>
          <span class="text-text-faint">/</span>
          <span class="text-text-muted">{knowledgeCategoryZh(topic.data.category)}</span>
          <span class="px-2 py-1 rounded border border-accent-primary/30 text-accent-primary bg-accent-primary/5">{topic.data.status === 'active' ? '持续研究' : topic.data.status}</span>
        </div>
        <h1 class="font-display font-black text-4xl md:text-6xl text-text-primary tracking-tight leading-tight">{topic.data.title}</h1>
        <p class="max-w-3xl text-base md:text-lg text-text-secondary leading-relaxed">{topic.data.excerpt}</p>
        <div class="flex flex-wrap gap-2 text-[10px] font-mono text-text-muted">
          {topic.data.engine && <span class="px-2.5 py-1 rounded border border-border-subtle bg-surface-card">{topic.data.engine}</span>}
          {topic.data.engineVersion && <span class="px-2.5 py-1 rounded border border-border-subtle bg-surface-card">{topic.data.engineVersion}</span>}
          <span class="px-2.5 py-1 rounded border border-border-subtle bg-surface-card">{articles.length} 篇关联文章</span>
        </div>
      </section>

      <section class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_280px] gap-8 items-start">
        <article class="article-body max-w-none prose prose-invert">
          <Content />
        </article>
        <aside class="lg:sticky lg:top-24 p-5 rounded-xl border border-border-subtle bg-surface-card space-y-4">
          <div class="text-[10px] font-mono text-accent-primary uppercase tracking-widest">源码范围</div>
          {topic.data.sourceRoot && <code class="block text-[11px] leading-relaxed text-text-secondary break-all">{topic.data.sourceRoot}</code>}
          <div class="text-[10px] font-mono text-text-faint uppercase tracking-widest">专题阶段</div>
          <ol class="space-y-2">
            {stages.map((stage) => (
              <li class="flex gap-2 text-xs text-text-muted">
                <span class="font-mono text-accent-primary">{String(stage.order / 10).padStart(2, '0')}</span>
                <a href={`#stage-${stage.id}`} class="hover:text-text-primary transition-colors">{stage.title}</a>
              </li>
            ))}
          </ol>
        </aside>
      </section>

      <section class="space-y-8">
        <div class="space-y-2">
          <span class="text-[10px] font-mono text-accent-primary uppercase tracking-widest">Reading Path</span>
          <h2 class="font-display font-bold text-2xl md:text-3xl text-text-primary">专题阅读路线</h2>
          <p class="text-sm text-text-muted">按阶段建立概念，再进入源码和工程问题。完整推导保留在对应知识文章中。</p>
        </div>

        <div class="space-y-6">
          {stages.map((stage) => {
            const stageArticles = sortedArticles.filter((article) => topicRef(article)?.stage === stage.id);
            return (
              <section id={`stage-${stage.id}`} class="scroll-mt-28 space-y-4">
                <div class="border-b border-border-subtle pb-3">
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-xs text-accent-primary">{String(stage.order / 10).padStart(2, '0')}</span>
                    <h3 class="font-display font-bold text-xl text-text-primary">{stage.title}</h3>
                  </div>
                  <p class="mt-2 text-sm text-text-muted leading-relaxed">{stage.description}</p>
                </div>
                {stageArticles.length > 0 ? (
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {stageArticles.map((article) => {
                      const ref = topicRef(article);
                      return (
                        <a href={`${baseURL}knowledge/${article.slug}/`} class="group p-5 rounded-xl border border-border-subtle bg-surface-card hover:border-accent-primary/40 transition-colors">
                          <div class="flex items-center justify-between gap-3 text-[9px] font-mono text-text-faint uppercase tracking-wider">
                            <span class="text-accent-primary">{ref ? roleLabels[ref.role] : '专题文章'}</span>
                            <span>{article.data.readTime}</span>
                          </div>
                          <h4 class="mt-3 font-display font-semibold text-base text-text-primary group-hover:text-accent-primary transition-colors leading-snug">{article.data.title}</h4>
                          <p class="mt-2 text-xs text-text-muted leading-relaxed line-clamp-3">{article.data.excerpt}</p>
                          <div class="mt-4 text-[10px] font-mono text-text-faint">{knowledgeSubtopicZh(article.data.category, article.data.subtopic)} · {formatZhDate(article.data.date)}</div>
                        </a>
                      );
                    })}
                  </div>
                ) : (
                  <div class="p-5 rounded-xl border border-dashed border-border-subtle text-xs text-text-faint">此阶段将在完成对应源码研究后补充文章。</div>
                )}
              </section>
            );
          })}
        </div>
      </section>
    </main>
  </body>
</html>
