---
import Layout from '../layouts/Layout.astro';
import App from '../App.tsx';
import { loadKnowledge, loadKnowledgeDomains } from '../lib/content';

const [knowledgeArticles, knowledgeDomains] = await Promise.all([loadKnowledge(), loadKnowledgeDomains()]);
---

<Layout>
  <App client:load knowledgeArticles={knowledgeArticles} knowledgeDomains={knowledgeDomains} />
</Layout>
