---
import TicketCheckout from '../../ticket/TicketCheckout';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F4F2ED" />
    <meta name="description" content="有些体验，值得亲手感受。NITE 交互案例：选择全息材质，弯折、翻转并撕开属于你的通行证。" />
    <link rel="icon" type="image/svg+xml" href={`${base}ticket-favicon.svg`} />
    <title>Ticket Tear · 有些体验，值得亲手感受。 | NITE</title>
  </head>
  <body>
    <TicketCheckout client:load portfolioHref={`${base}about/`} returnLabel="返回 TOY" />
  </body>
</html>
