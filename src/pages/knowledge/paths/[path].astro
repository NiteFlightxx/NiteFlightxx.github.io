---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import KnowledgeSiteHeader from '../../../components/KnowledgeSiteHeader.astro';
import { SITE } from '../../../consts';
import '../../../index.css';
type Domain = CollectionEntry<'knowledgeDomains'>;
type Article = CollectionEntry<'knowledge'>;
interface Props { domain: Domain; path: Domain['data']['learningPaths'][number]; articles: Article[]; }
export async function getStaticPaths() {
  const [domains, articles] = await Promise.all([getCollection('knowledgeDomains'), getCollection('knowledge', (entry) => !entry.data.draft)]);
  const articleBySlug = new Map(articles.map((article) => [article.slug, article]));
  return domains.flatMap((domain) => domain.data.learningPaths.map((path) => ({
    params: { path: path.id },
    props: { domain, path, articles: path.articles.map((slug) => articleBySlug.get(slug)).filter(Boolean) as Article[] },
  })));
}
const { domain, path, articles } = Astro.props as Props;
const baseURL = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><BaseHead title={`${path.title} · ${SITE.shortTitle}`} description={path.description} type="website" canonicalPath={Astro.url.pathname} /></head>
  <body class="bg-surface-base text-text-secondary">
    <div class="fixed inset-0 -z-20 bg-surface-base"></div><div class="grain-overlay" aria-hidden="true"></div>
    <KnowledgeSiteHeader current="knowledge" />
    <main class="max-w-4xl mx-auto px-6 md:px-8 py-12 md:py-20 space-y-9">
      <nav aria-label="面包屑" class="text-xs font-mono text-text-faint"><a href={`${baseURL}knowledge/`} class="hover:text-accent-primary">知识库</a> / <a href={`${baseURL}knowledge/paths/`} class="hover:text-accent-primary">学习路线</a> / {path.title}</nav>
      <section><a href={`${baseURL}knowledge/domain/${domain.slug}/`} class="text-[10px] font-mono text-accent-primary hover:text-text-primary">{domain.data.title}领域 →</a><h1 class="mt-3 font-display font-black text-4xl md:text-5xl text-text-primary">{path.title}</h1><p class="mt-4 text-sm md:text-base text-text-muted leading-relaxed">{path.description}</p><div class="mt-5 text-[10px] font-mono text-text-faint">{articles.length} 篇文章 · 按推荐顺序阅读</div></section>
      <ol class="space-y-3">
        {articles.map((article, index) => <li><a href={`${baseURL}knowledge/${article.slug}/`} class="group flex gap-5 rounded-xl border border-border-subtle bg-surface-card p-5 hover:border-accent-primary/40 transition-colors"><span class="font-mono text-sm text-accent-primary">{String(index + 1).padStart(2, '0')}</span><div><h2 class="font-display font-semibold text-base text-text-primary group-hover:text-accent-primary">{article.data.title}</h2><p class="mt-2 text-xs text-text-muted leading-relaxed">{article.data.excerpt}</p><span class="mt-3 block text-[10px] font-mono text-text-faint">{article.data.readTime}</span></div></a></li>)}
      </ol>
    </main>
  </body>
</html>



