---
import BaseHead from '../../../components/BaseHead.astro';
import KnowledgeSiteHeader from '../../../components/KnowledgeSiteHeader.astro';
import { SITE } from '../../../consts';
import { loadKnowledgeDomains } from '../../../lib/content';
import '../../../index.css';
const domains = await loadKnowledgeDomains();
const paths = domains.flatMap((domain) => domain.learningPaths.map((path) => ({ ...path, domain })));
const baseURL = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><BaseHead title={`学习路线 · ${SITE.shortTitle}`} description="按顺序学习数学、物理、引擎源码和工程实践" type="website" canonicalPath={Astro.url.pathname} /></head>
  <body class="bg-surface-base text-text-secondary">
    <div class="fixed inset-0 -z-20 bg-surface-base"></div><div class="grain-overlay" aria-hidden="true"></div>
    <KnowledgeSiteHeader current="knowledge" />
    <main class="max-w-5xl mx-auto px-6 md:px-8 py-12 md:py-20 space-y-9">
      <nav aria-label="面包屑" class="text-xs font-mono text-text-faint"><a href={`${baseURL}knowledge/`} class="hover:text-accent-primary">知识库</a> / 学习路线</nav>
      <section><h1 class="font-display font-black text-4xl md:text-5xl text-text-primary">学习路线</h1><p class="mt-4 text-sm text-text-muted">每条路线按推荐顺序组织现有文章；文章正文只保留一份。</p></section>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {paths.map((path) => <a href={`${baseURL}knowledge/paths/${path.id}/`} class="group rounded-xl border border-border-subtle bg-surface-card p-6 hover:border-accent-primary/40 transition-colors"><span class="text-[10px] font-mono text-accent-primary">{path.domain.title}</span><h2 class="mt-2 font-display font-bold text-xl text-text-primary group-hover:text-accent-primary">{path.title}</h2><p class="mt-3 text-sm text-text-muted leading-relaxed">{path.description}</p><div class="mt-5 text-[10px] font-mono text-text-faint">{path.articles.length} 篇文章 →</div></a>)}
      </div>
    </main>
  </body>
</html>



