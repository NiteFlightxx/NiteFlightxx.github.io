---
import { getCollection } from 'astro:content';
import KnowledgeDocument from '../../../components/KnowledgeDocument.astro';
import Layout from '../../../layouts/Layout.astro';
import StaticSiteHeader from '../../../components/StaticSiteHeader.astro';
import { readingGroups } from '../../../lib/readingOrder';
export async function getStaticPaths() {
  const domains = await getCollection('knowledgeDomains');
  return domains.map(domain => ({ params: { domain: domain.slug }, props: { domain } }));
}
const { domain } = Astro.props;
const entries = await getCollection('knowledge', entry => !entry.data.draft && !entry.data.redirectTo);
const groups = readingGroups(entries.map(entry => ({ slug: entry.slug, title: entry.data.title })));
const group = groups.find(group => group.domain === domain.slug);
const firstSlug = group?.sections[0]?.articles[0]?.slug;
const entry = entries.find(entry => entry.slug === firstSlug) ?? entries.find(entry => entry.data.category === domain.data.category);
---
{entry ? <KnowledgeDocument entry={entry} indexBody={false} /> : <Layout title={`${domain.data.title} · NITE`}>
  <StaticSiteHeader activeTab="knowledge" />
  <main id="main-content" class="max-w-4xl mx-auto px-6 py-12"><h1>{domain.data.title}</h1><p class="my-6">暂无公开文档。</p><a href={`${import.meta.env.BASE_URL}knowledge/`}>返回知识库</a></main>
</Layout>}



