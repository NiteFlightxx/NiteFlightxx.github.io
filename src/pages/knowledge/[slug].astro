---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { knowledgeCategoryZh, knowledgeSubtopicZh } from '../../lib/taxonomy';
import { getRelatedArticles } from '../../lib/relatedArticles';
import type { ContentArticle } from '../../types';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge', (entry) => !entry.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const baseURL = import.meta.env.BASE_URL;

// Localize the ISO date the same way the SPA loader does (content.ts formatZhDate).
function formatZhDate(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
}

// Build a ContentArticle-shaped object from a collection entry so the
// relatedness scorer (which reads categoryKey / subtopic / tags) works
// without re-loading the full HTML body. html/searchText are left empty —
// they're only needed for the SPA search, not for related-article scoring.
function toArticleShape(slug: string, data: Record<string, any>): ContentArticle {
  const categoryKey = String(data.category ?? '');
  const subtopicKey = data.subtopic ? String(data.subtopic) : '';
  return {
    id: slug,
    slug,
    title: String(data.title ?? ''),
    excerpt: String(data.excerpt ?? ''),
    date: formatZhDate(String(data.date ?? '')),
    category: knowledgeCategoryZh(categoryKey),
    categoryKey,
    subtopic: subtopicKey ? knowledgeSubtopicZh(categoryKey, subtopicKey) : undefined,
    tags: Array.isArray(data.tags) ? (data.tags as string[]) : [],
    readTime: data.readTime ? String(data.readTime) : undefined,
  };
}

// Load every published article to score relatedness against the current one.
const allEntries = await getCollection('knowledge', (e) => !e.data.draft);
const allArticles: ContentArticle[] = allEntries.map((e) => toArticleShape(e.slug, e.data as Record<string, any>));
const currentArticle = toArticleShape(entry.slug, entry.data as Record<string, any>);
const relatedArticles = getRelatedArticles(currentArticle, allArticles, 3);
---

<ArticleLayout
  title={entry.data.title}
  excerpt={entry.data.excerpt}
  category={knowledgeCategoryZh(entry.data.category)}
  date={formatZhDate(entry.data.date)}
  readTime={entry.data.readTime}
  tags={entry.data.tags}
  headings={headings}
  backHref={`${baseURL}#knowledge`}
  backLabel="返回知识库"
  lang="zh"
  relatedArticles={relatedArticles}
>
  <Content />
</ArticleLayout>
