---
import { getCollection } from 'astro:content';
import KnowledgeDocument from '../../components/KnowledgeDocument.astro';
export async function getStaticPaths() {
  const entries = await getCollection('knowledge', entry => !entry.data.draft);
  return entries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<KnowledgeDocument entry={entry} />
