---
import BaseHead from '../../components/BaseHead.astro';
import KnowledgeSiteHeader from '../../components/KnowledgeSiteHeader.astro';
import { SITE } from '../../consts';
import { loadKnowledgeDomains } from '../../lib/content';
import '../../index.css';
const domains = await loadKnowledgeDomains();
const baseURL = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><BaseHead title={`知识领域 · ${SITE.shortTitle}`} description="按领域和子主题浏览知识文章" type="website" canonicalPath={Astro.url.pathname} /></head>
  <body class="bg-surface-base text-text-secondary">
    <div class="fixed inset-0 -z-20 bg-surface-base"></div><div class="grain-overlay" aria-hidden="true"></div>
    <KnowledgeSiteHeader current="knowledge" />
    <main class="max-w-5xl mx-auto px-6 md:px-8 py-12 md:py-20 space-y-9">
      <nav aria-label="面包屑" class="text-xs font-mono text-text-faint"><a href={`${baseURL}knowledge/`} class="hover:text-accent-primary">知识库</a> / 知识领域</nav>
      <section><h1 class="font-display font-black text-4xl md:text-5xl text-text-primary">知识领域</h1><p class="mt-4 text-sm text-text-muted">选择领域，再按子主题查找文章。</p></section>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {domains.map((domain) => <a href={`${baseURL}knowledge/domain/${domain.id}/`} class="group rounded-xl border border-border-subtle bg-surface-card p-6 hover:border-accent-primary/40 transition-colors"><div class="flex items-center justify-between"><h2 class="font-display font-bold text-xl text-text-primary group-hover:text-accent-primary">{domain.title}</h2><span class="text-accent-primary">↗</span></div><p class="mt-3 text-sm text-text-muted leading-relaxed">{domain.excerpt}</p><div class="mt-5 text-[10px] font-mono text-text-faint">{domain.subtopicCount} 个子主题 · {domain.articleCount} 篇文章</div></a>)}
      </div>
    </main>
  </body>
</html>



