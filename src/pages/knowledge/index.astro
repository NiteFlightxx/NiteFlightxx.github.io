---
import Layout from '../../layouts/Layout.astro';
import StaticSiteHeader from '../../components/StaticSiteHeader.astro';
import KnowledgeView from '../../components/KnowledgeView';
import Footer from '../../components/Footer';
import { loadKnowledge } from '../../lib/content';

const articles = await loadKnowledge();
---

<Layout title="知识库 · NITE">
  <div class="min-h-screen bg-surface-base text-text-primary">
    <StaticSiteHeader activeTab="knowledge" />
    <main id="main-content"><KnowledgeView client:load articles={articles} lang="zh" /></main>
    <Footer lang="zh" />
  </div>
</Layout>
