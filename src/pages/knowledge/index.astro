---
import { getEntry } from 'astro:content';
import KnowledgeDocument from '../../components/KnowledgeDocument.astro';
const entry = await getEntry('knowledge', 'course-math-points-vectors');
if (!entry || entry.data.draft) throw new Error('Default knowledge document must be public.');
---
<KnowledgeDocument entry={entry} indexBody={false} />
<script>
  const scope = new URLSearchParams(location.search).get('scope');
  if (scope === 'favorites' || scope === 'recents') {
    location.replace(`${import.meta.env.BASE_URL}knowledge/library/?scope=${scope}`);
  }
</script>
