---
import BaseHead from '../components/BaseHead.astro';
import { SITE } from '../consts';
import 'katex/dist/katex.min.css';
import '../index.css';
import ArticleToc from '../components/ArticleToc';
import RelatedArticles from '../components/RelatedArticles';
import ArticleEnhancements from '../components/ArticleEnhancements';
import { Calendar, Clock, ArrowLeft } from 'lucide-react';
import type { ContentArticle } from '../types';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  excerpt?: string;
  category: string; // localized label (e.g. "动画")
  date: string; // localized display string
  readTime?: string;
  tags: string[];
  headings: TocHeading[];
  backHref: string; // absolute URL back to the feed tab, e.g. "/#knowledge"
  backLabel: string; // e.g. "返回知识库"
  lang: 'zh' | 'en';
  relatedArticles?: ContentArticle[];
}

const {
  title,
  excerpt,
  category,
  date,
  readTime,
  tags = [],
  headings,
  backHref,
  backLabel,
  lang = 'zh',
  relatedArticles = [],
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {SITE.shortTitle}</title>
    <BaseHead
      title={`${title} · ${SITE.shortTitle}`}
      description={excerpt ?? title}
      type="article"
      canonicalPath={Astro.url.pathname}
    />
  </head>
  <body class="bg-surface-base text-text-secondary">
    {/* Progressive enhancements: reading progress bar + code copy buttons.
        Hydrated as a client component; no-ops if .article-body isn't present.
        Also hosts the article-page theme toggle (no React SPA on these routes). */}
    <ArticleEnhancements client:load />

    {/* Static background — reading pages keep the dark base + subtle grain only,
        no animated layers (SideRays / DynamicLinesBg) to reduce visual fatigue. */}
    <div class="fixed inset-0 -z-20 bg-surface-base"></div>
    <div class="grain-overlay" aria-hidden="true"></div>

    {/* Sticky minimal top bar */}
    <header class="sticky top-0 z-50 glass-panel border-b border-border-subtle px-6 md:px-12 py-3.5 flex items-center justify-between select-none">
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-2 font-display font-black text-base tracking-widest text-text-primary hover:text-accent-primary transition-colors">
          <svg class="w-5 h-5" viewBox="132 92 284 296" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M150 150L170 170L170 350L150 370Z"/>
            <path transform="translate(10, 0)" d="M340 120L360 100L360 300L340 280Z"/>
            <path d="M140 110 C200 120,250 180,300 260 C330 305,365 340,400 355 C360 350,315 320,265 250 C220 185,195 135,140 110 Z"/>
          </svg>
          NITE
        </a>
        <span class="hidden sm:block text-[10px] font-mono text-text-faint tracking-widest">/ {category}</span>
      </div>
      <div class="flex items-center gap-4">
        <a
          href={backHref}
          class="flex items-center gap-2 text-xs font-mono text-text-muted hover:text-text-primary transition-colors group"
        >
          <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          {backLabel}
        </a>
        {/* Theme toggle — mirrors the SPA Header's behavior. The persisted
            choice lives in localStorage('theme'); BaseHead's inline script
            applies it pre-paint, this button flips it live. */}
        <button
          type="button"
          id="article-theme-toggle"
          class="p-2 text-text-muted hover:text-text-primary transition-colors duration-200 rounded-lg hover:bg-surface-raised/20 cursor-pointer"
          aria-label="切换主题"
        />
        <script is:inline>
          // Article pages are static (no SPA), so the theme toggle renders the
          // same Sun/Moon glyphs as inline SVG and flips the html class directly.
          (function () {
            var btn = document.getElementById('article-theme-toggle');
            if (!btn) return;
            var sunSVG = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>';
            var moonSVG = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';
            function render() {
              btn.innerHTML = document.documentElement.classList.contains('light-theme') ? sunSVG : moonSVG;
            }
            render();
            btn.addEventListener('click', function () {
              var isLight = document.documentElement.classList.toggle('light-theme');
              try { localStorage.setItem('theme', isLight ? 'light' : 'dark'); } catch (e) {}
              render();
            });
          })();
        </script>
      </div>
    </header>

    {/* Main: the TOC rail is pinned to the viewport's left edge as a fixed
        sidebar; the article is a centered, fixed-width reading column that
        ignores the rail — so it stays visually centered regardless of TOC. */}
    <div class="relative w-full py-10">
      {/* Left TOC — fixed to the left edge, sticky-feeling via position:fixed.
          Hidden on small screens (no room). */}
      <aside class="hidden lg:block fixed left-0 top-24 w-[300px] px-8 max-h-[calc(100vh-8rem)] overflow-y-auto z-30">
        <ArticleToc client:load headings={headings} lang={lang} />
      </aside>

      {/* Article body — centered reading column */}
      <article class="article-body w-full max-w-3xl mx-auto px-6 md:px-8">
        {/* Header metadata */}
        <div class="border-b border-white/5 pb-8 mb-10">
          <div class="flex items-center gap-2 text-[10px] font-mono text-brand-accent-orange uppercase tracking-wider mb-3">
            <span>{category}</span>
          </div>
          <h1 class="font-display font-medium text-2xl md:text-4xl text-white tracking-tight leading-tight mb-6">
            {title}
          </h1>
          {excerpt && (
            <p class="text-sm md:text-base text-gray-400 leading-relaxed mb-5">{excerpt}</p>
          )}
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-gray-500">
            <span class="flex items-center gap-1.5">
              <Calendar className="w-3.5 h-3.5 text-gray-600" />
              {date}
            </span>
            {readTime && (
              <span class="flex items-center gap-1.5">
                <Clock className="w-3.5 h-3.5 text-gray-600" />
                {readTime}
              </span>
            )}
          </div>
        </div>

        {/* Rendered Markdown + KaTeX from <Content /> */}
        <slot />

        {/* Tag cloud */}
        <div class="mt-12 pt-8 border-t border-white/5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="px-2.5 py-1 text-[10px] font-mono bg-brand-gray-800 text-gray-400 border border-white/5 rounded">
              #{tag.toUpperCase()}
            </span>
          ))}
        </div>

        {/* Related articles — computed at build time, hydrated for hover states */}
        {relatedArticles.length > 0 && (
          <RelatedArticles client:load articles={relatedArticles} lang={lang} />
        )}
      </article>
    </div>
  </body>
</html>
