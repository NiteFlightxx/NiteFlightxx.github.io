---
import BaseHead from '../components/BaseHead.astro';
import StaticSiteHeader from '../components/StaticSiteHeader.astro';
import { SITE } from '../consts';
import 'katex/dist/katex.min.css';
import '../index.css';
import ArticleToc from '../components/ArticleToc';
import RelatedArticles from '../components/RelatedArticles';
import ArticleEnhancements from '../components/ArticleEnhancements';
import KnowledgeTree from '../components/KnowledgeTree';
import ReaderActions from '../components/ReaderActions';
import DemoMount from '../components/demos/DemoMount';
import { Calendar, Clock, ArrowLeft } from 'lucide-react';
import type { ContentArticle, KnowledgeSource } from '../types';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  excerpt?: string;
  category: string; // localized label (e.g. "动画")
  subtopic?: string;
  difficulty?: string;
  pageType?: string;
  date: string; // localized display string
  readTime?: string;
  tags: string[];
  headings: TocHeading[];
  backHref: string; // absolute URL back to the knowledge hub
  backLabel: string; // e.g. "返回知识库"
  breadcrumbs?: { label: string; href?: string }[];
  lang: 'zh' | 'en';
  relatedArticles?: ContentArticle[];
  topicContext?: {
    slug: string;
    title: string;
    stageTitle: string;
    roleLabel: string;
    previous?: { slug: string; title: string };
    next?: { slug: string; title: string };
  };
  learningLinks?: {
    prerequisites: { slug: string; title: string }[];
    nextArticles: { slug: string; title: string }[];
  };
  currentSlug: string;
  allArticles: ContentArticle[];
  backlinks?: { slug: string; title: string }[];
  outgoingLinks?: { slug: string; title: string }[];
  sources?: KnowledgeSource[];
  historyUrl?: string;
  rawUrl?: string;
}

const {
  title,
  excerpt,
  category,
  subtopic,
  difficulty,
  pageType,
  date,
  readTime,
  tags = [],
  headings,
  backHref,
  backLabel,
  breadcrumbs = [],
  lang = 'zh',
  relatedArticles = [],
  topicContext,
  learningLinks,
  currentSlug,
  allArticles,
  backlinks = [],
  outgoingLinks = [],
  sources = [],
  historyUrl,
  rawUrl,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {SITE.shortTitle}</title>
    <BaseHead
      title={`${title} · ${SITE.shortTitle}`}
      description={excerpt ?? title}
      type="article"
      canonicalPath={Astro.url.pathname}
    />
    <meta data-pagefind-meta="title" content={title} />
    <meta data-pagefind-meta="category" content={category} />
    {subtopic && <meta data-pagefind-meta="subtopic" content={subtopic} />}
    {difficulty && <meta data-pagefind-meta="difficulty" content={difficulty} />}
    {pageType && <meta data-pagefind-meta="pageType" content={pageType} />}
  </head>
  <body class="bg-surface-base text-text-secondary">
    {/* Progressive enhancements: reading progress bar + code copy buttons.
        Hydrated as a client component; no-ops if .article-body isn't present. */}
    <ArticleEnhancements client:load />

    {/* Interactive demo mount for articles that embed data-demo placeholders
        (see components/demos/DemoMount.tsx). No-op when the article has none. */}
    <DemoMount client:load />

    {/* Static background — reading pages keep the dark base + subtle grain only,
        no animated layers (SideRays / DynamicLinesBg) to reduce visual fatigue. */}
    <div class="fixed inset-0 -z-20 bg-surface-base"></div>
    <div class="grain-overlay" aria-hidden="true"></div>

    <StaticSiteHeader activeTab="knowledge" />

    <div class="knowledge-reader-shell mx-auto grid w-full max-w-[1500px] grid-cols-1 gap-7 px-4 py-8 md:px-6 xl:grid-cols-[280px_minmax(0,780px)_260px] 2xl:gap-9">
      <aside class="hidden xl:block">
        <div class="sticky top-24"><KnowledgeTree client:only="react" articles={allArticles} currentSlug={currentSlug} /></div>
      </aside>

      <main class="min-w-0">
        <details class="mb-5 xl:hidden glass-panel rounded-xl border border-border-subtle">
          <summary class="cursor-pointer px-4 py-3 font-mono text-xs text-text-muted">浏览知识目录</summary>
          <KnowledgeTree client:only="react" articles={allArticles} currentSlug={currentSlug} />
        </details>
        <div class="mb-5 xl:hidden"><ReaderActions client:media="(max-width: 1279px)" slug={currentSlug} title={title} category={category} url={Astro.url.pathname} /></div>
      <article class="article-body w-full px-2 md:px-4" data-pagefind-body>
        <a href={backHref} class="inline-flex items-center gap-2 mb-6 text-xs font-mono text-text-muted hover:text-accent-primary transition-colors group"><ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />{backLabel}</a>
        {/* Header metadata */}
        <div class="border-b border-white/5 pb-8 mb-10">
          {breadcrumbs.length > 0 && (
            <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-2 text-[10px] font-mono text-gray-600">
              {breadcrumbs.map((crumb, index) => <span>{index > 0 && '/ '}{crumb.href ? <a href={crumb.href} class="hover:text-brand-accent-orange">{crumb.label}</a> : crumb.label}</span>)}
            </nav>
          )}
          <div class="flex items-center gap-2 text-[10px] font-mono text-brand-accent-orange uppercase tracking-wider mb-3">
            <span data-pagefind-filter={`category:${category}`}>{category}</span>
            {subtopic && <span data-pagefind-filter={`subtopic:${subtopic}`} class="sr-only">{subtopic}</span>}
            {difficulty && <span data-pagefind-filter={`difficulty:${difficulty}`} class="sr-only">{difficulty}</span>}
            {pageType && <span data-pagefind-filter={`pageType:${pageType}`} class="sr-only">{pageType}</span>}
          </div>
          {topicContext && (
            <div class="mb-5 flex flex-wrap items-center gap-2 text-[10px] font-mono">
              <span class="text-gray-600 uppercase tracking-wider">专题路径</span>
              <a href={`${import.meta.env.BASE_URL}projects/${topicContext.slug}/`} class="text-brand-accent-orange hover:text-white transition-colors">
                {topicContext.title}
              </a>
              <span class="text-gray-600">/</span>
              <span class="text-gray-500">{topicContext.stageTitle} · {topicContext.roleLabel}</span>
            </div>
          )}
          <h1 class="font-display font-medium text-2xl md:text-4xl text-white tracking-tight leading-tight mb-6">
            {title}
          </h1>
          {excerpt && (
            <p class="text-sm md:text-base text-gray-400 leading-relaxed mb-5">{excerpt}</p>
          )}
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-gray-500">
            <span class="flex items-center gap-1.5">
              <Calendar className="w-3.5 h-3.5 text-gray-600" />
              {date}
            </span>
            {readTime && (
              <span class="flex items-center gap-1.5">
                <Clock className="w-3.5 h-3.5 text-gray-600" />
                {readTime}
              </span>
            )}
          </div>
        </div>

        {/* Rendered Markdown + KaTeX from <Content /> */}
        <slot />

        {learningLinks && (learningLinks.prerequisites.length > 0 || learningLinks.nextArticles.length > 0) && (
          <section class="mt-12 pt-8 border-t border-white/5 grid grid-cols-1 md:grid-cols-2 gap-6" aria-label="文章学习关系">
            {learningLinks.prerequisites.length > 0 && (
              <div>
                <div class="text-[9px] font-mono text-gray-600 uppercase tracking-wider mb-3">阅读前建议</div>
                <div class="space-y-2">
                  {learningLinks.prerequisites.map((article) => <a href={`${import.meta.env.BASE_URL}knowledge/${article.slug}/`} class="block text-sm text-gray-400 hover:text-brand-accent-orange transition-colors">{article.title}</a>)}
                </div>
              </div>
            )}
            {learningLinks.nextArticles.length > 0 && (
              <div>
                <div class="text-[9px] font-mono text-gray-600 uppercase tracking-wider mb-3">接下来阅读</div>
                <div class="space-y-2">
                  {learningLinks.nextArticles.map((article) => <a href={`${import.meta.env.BASE_URL}knowledge/${article.slug}/`} class="block text-sm text-gray-400 hover:text-brand-accent-orange transition-colors">{article.title}</a>)}
                </div>
              </div>
            )}
          </section>
        )}

        {(backlinks.length > 0 || outgoingLinks.length > 0 || sources.length > 0) && (
          <section class="mt-12 grid grid-cols-1 gap-5 border-t border-border-subtle pt-8 md:grid-cols-2" aria-label="知识关系与来源">
            {outgoingLinks.length > 0 && (
              <div class="rounded-xl border border-border-subtle bg-surface-card/40 p-5">
                <h2 class="!mt-0 !border-0 !p-0 font-mono !text-xs uppercase tracking-widest text-text-muted">本文引用</h2>
                <div class="mt-3 space-y-2">{outgoingLinks.slice(0, 10).map((link) => <a href={`${import.meta.env.BASE_URL}knowledge/${link.slug}/`} class="block text-sm text-text-secondary hover:text-accent-primary">{link.title}</a>)}</div>
              </div>
            )}
            {backlinks.length > 0 && (
              <div class="rounded-xl border border-border-subtle bg-surface-card/40 p-5">
                <h2 class="!mt-0 !border-0 !p-0 font-mono !text-xs uppercase tracking-widest text-text-muted">被这些页面引用</h2>
                <div class="mt-3 space-y-2">{backlinks.slice(0, 10).map((link) => <a href={`${import.meta.env.BASE_URL}knowledge/${link.slug}/`} class="block text-sm text-text-secondary hover:text-accent-primary">{link.title}</a>)}</div>
              </div>
            )}
            {sources.length > 0 && (
              <div class="rounded-xl border border-border-subtle bg-surface-card/40 p-5 md:col-span-2">
                <h2 class="!mt-0 !border-0 !p-0 font-mono !text-xs uppercase tracking-widest text-text-muted">资料来源</h2>
                <div class="mt-3 flex flex-wrap gap-2">{sources.map((source) => <a href={source.url} target="_blank" rel="noreferrer" class="rounded-lg border border-border-subtle px-3 py-2 text-xs text-text-secondary hover:border-accent-primary/40 hover:text-accent-primary">{source.title}</a>)}</div>
              </div>
            )}
          </section>
        )}

        {/* Tag cloud */}
        <div class="mt-12 pt-8 border-t border-white/5 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="px-2.5 py-1 text-[10px] font-mono bg-brand-gray-800 text-gray-400 border border-white/5 rounded">
              #{tag.toUpperCase()}
            </span>
          ))}
        </div>

        {topicContext && (topicContext.previous || topicContext.next) && (
          <nav class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-3" aria-label="专题文章导航">
            {topicContext.previous ? (
              <a href={`${import.meta.env.BASE_URL}knowledge/${topicContext.previous.slug}/`} class="p-4 rounded-xl border border-white/5 bg-brand-gray-900/40 hover:border-brand-accent-orange/40 transition-colors">
                <span class="block text-[9px] font-mono text-gray-600 uppercase tracking-wider">专题上一篇</span>
                <span class="mt-2 block text-sm text-gray-300 hover:text-white">{topicContext.previous.title}</span>
              </a>
            ) : <div />}
            {topicContext.next && (
              <a href={`${import.meta.env.BASE_URL}knowledge/${topicContext.next.slug}/`} class="p-4 rounded-xl border border-white/5 bg-brand-gray-900/40 hover:border-brand-accent-orange/40 transition-colors md:text-right">
                <span class="block text-[9px] font-mono text-gray-600 uppercase tracking-wider">专题下一篇</span>
                <span class="mt-2 block text-sm text-gray-300 hover:text-white">{topicContext.next.title}</span>
              </a>
            )}
          </nav>
        )}

        {/* Related articles — computed at build time, hydrated for hover states */}
        {relatedArticles.length > 0 && (
          <RelatedArticles client:load articles={relatedArticles} lang={lang} />
        )}
        {(historyUrl || rawUrl) && (
          <footer class="mt-10 flex flex-wrap gap-4 border-t border-border-subtle pt-6 font-mono text-[10px] text-text-faint">
            {historyUrl && <a href={historyUrl} target="_blank" rel="noreferrer" class="hover:text-accent-primary">查看 Git 修改历史</a>}
            {rawUrl && <a href={rawUrl} target="_blank" rel="noreferrer" class="hover:text-accent-primary">查看原始 Markdown</a>}
          </footer>
        )}
      </article>
      </main>

      <aside class="hidden xl:block">
        <div class="sticky top-24 space-y-4">
          <ReaderActions client:media="(min-width: 1280px)" slug={currentSlug} title={title} category={category} url={Astro.url.pathname} />
          <ArticleToc client:load headings={headings} lang={lang} />
          <a href={`${import.meta.env.BASE_URL}knowledge/graph/?center=${currentSlug}`} class="block rounded-xl border border-border-subtle bg-surface-card/40 px-4 py-3 text-center font-mono text-[10px] uppercase tracking-wider text-text-muted hover:border-accent-primary/30 hover:text-accent-primary">在知识图谱中查看</a>
        </div>
      </aside>
    </div>
  </body>
</html>
