---
import BaseHead from '../components/BaseHead.astro';
import StaticSiteHeader from '../components/StaticSiteHeader.astro';
import { SITE } from '../consts';
import 'katex/dist/katex.min.css';
import '../index.css';
import ArticleToc from '../components/ArticleToc';
import RelatedArticles from '../components/RelatedArticles';
import ArticleEnhancements from '../components/ArticleEnhancements';
import DocumentNavigation from '../components/DocumentNavigation';
import { articleHref, type ReadingContext, type ReadingGroup } from '../lib/readingOrder';
import ReaderActions from '../components/ReaderActions';
import DemoMount from '../components/demos/DemoMount';
import { Calendar, Clock, ArrowLeft } from 'lucide-react';
import type { ContentArticle, KnowledgeSource } from '../types';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  readingContext?: ReadingContext;
  readingGroups: ReadingGroup[];
  canonicalPath?: string;
  indexBody?: boolean;
  title: string;
  excerpt?: string;
  category: string; // localized label (e.g. "动画")
  subtopic?: string;
  difficulty?: string;
  pageType?: string;
  date: string; // localized display string
  readTime?: string;
  tags: string[];
  headings: TocHeading[];
  backHref: string; // absolute URL back to the knowledge hub
  backLabel: string; // e.g. "返回知识库"
  breadcrumbs?: { label: string; href?: string }[];
  lang: 'zh' | 'en';
  relatedArticles?: ContentArticle[];
  topicContext?: {
    slug: string;
    title: string;
    stageTitle: string;
    roleLabel: string;
    previous?: { slug: string; title: string };
    next?: { slug: string; title: string };
  };
  learningLinks?: {
    prerequisites: { slug: string; title: string }[];
    nextArticles: { slug: string; title: string }[];
  };
  currentSlug: string;
  backlinks?: { slug: string; title: string }[];
  outgoingLinks?: { slug: string; title: string }[];
  sources?: KnowledgeSource[];
  historyUrl?: string;
  rawUrl?: string;
}

const {
  readingContext,
  readingGroups,
  canonicalPath = Astro.url.pathname,
  indexBody = true,
  title,
  excerpt,
  category,
  subtopic,
  difficulty,
  pageType,
  date,
  readTime,
  tags = [],
  headings,
  backHref,
  backLabel,
  breadcrumbs = [],
  lang = 'zh',
  relatedArticles = [],
  topicContext,
  learningLinks,
  currentSlug,
  backlinks = [],
  outgoingLinks = [],
  sources = [],
  historyUrl,
  rawUrl,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · {SITE.shortTitle}</title>
    <BaseHead
      title={`${title} · ${SITE.shortTitle}`}
      description={excerpt ?? title}
      type="article"
      canonicalPath={canonicalPath}
    />
    <meta data-pagefind-meta="title" content={title} />
    <meta data-pagefind-meta="category" content={category} />
    {subtopic && <meta data-pagefind-meta="subtopic" content={subtopic} />}
    {difficulty && <meta data-pagefind-meta="difficulty" content={difficulty} />}
    {pageType && <meta data-pagefind-meta="pageType" content={pageType} />}
  </head>
  <body class="bg-surface-base text-text-secondary">
    {/* Progressive enhancements: reading progress bar + code copy buttons.
        Hydrated as a client component; no-ops if .article-body isn't present. */}
    <ArticleEnhancements client:load />

    {/* Interactive demo mount for articles that embed data-demo placeholders
        (see components/demos/DemoMount.tsx). No-op when the article has none. */}
    <DemoMount client:load />

    <StaticSiteHeader activeTab="knowledge" />

    <div class="knowledge-reader-shell">
      <aside class="document-sidebar"><div class="sticky top-28"><DocumentNavigation groups={readingGroups} current={currentSlug} /></div></aside>
      <main id="main-content" class="reader-main min-w-0">
        <div class="document-mobile-bars">
          <details class="document-mobile-navigation rounded-lg border border-border-subtle">
            <summary class="cursor-pointer px-4 py-3 text-xs text-text-muted">文档目录</summary>
            <div class="border-t border-border-subtle p-3"><DocumentNavigation groups={readingGroups} current={currentSlug} /></div>
          </details>
          <details class="document-reader-tools rounded-lg border border-border-subtle">
            <summary class="cursor-pointer px-4 py-3 text-xs text-text-muted">本文目录与阅读设置</summary>
            <div class="space-y-3 border-t border-border-subtle p-3">
              <ArticleToc client:load headings={headings} lang={lang} />
              <ReaderActions client:media="(max-width: 1099px)" slug={currentSlug} title={title} category={category} url={canonicalPath} />
            </div>
          </details>
        </div>
      <article class="article-body w-full" data-pagefind-body={indexBody ? true : undefined}>
        <a href={backHref} class="inline-flex items-center gap-2 mb-6 text-xs font-mono text-text-muted hover:text-accent-primary transition-colors group"><ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />{backLabel}</a>
        {/* Header metadata */}
        <header class="article-header border-b border-border-subtle pb-8 mb-10">
          {breadcrumbs.length > 0 && (
            <nav aria-label="面包屑" class="mb-5 flex flex-wrap items-center gap-2 text-[10px] font-mono text-text-faint">
              {breadcrumbs.map((crumb, index) => <span>{index > 0 && '/ '}{crumb.href ? <a href={crumb.href} class="hover:text-accent-primary">{crumb.label}</a> : crumb.label}</span>)}
            </nav>
          )}
          <div class="flex items-center gap-2 text-[10px] font-mono text-accent-primary uppercase tracking-wider mb-3">
            <span data-pagefind-filter={`category:${category}`}>{category}</span>
            {subtopic && <span data-pagefind-filter={`subtopic:${subtopic}`} class="sr-only">{subtopic}</span>}
            {difficulty && <span data-pagefind-filter={`difficulty:${difficulty}`} class="sr-only">{difficulty}</span>}
            {pageType && <span data-pagefind-filter={`pageType:${pageType}`} class="sr-only">{pageType}</span>}
          </div>
          {topicContext && (
            <div class="mb-5 flex flex-wrap items-center gap-2 text-[10px] font-mono">
              <span class="text-text-faint uppercase tracking-wider">专题路径</span>
              <a href={`${import.meta.env.BASE_URL}projects/${topicContext.slug}/`} class="text-accent-primary hover:text-text-primary transition-colors">
                {topicContext.title}
              </a>
              <span class="text-text-faint">/</span>
              <span class="text-text-faint">{topicContext.stageTitle} · {topicContext.roleLabel}</span>
            </div>
          )}
          <h1 class="font-display font-semibold text-2xl md:text-3xl text-text-primary tracking-tight leading-normal mb-5">
            {title}
          </h1>
          {excerpt && (
            <p class="article-summary text-sm text-text-muted leading-relaxed mb-5">{excerpt}</p>
          )}
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-text-faint">
            <span class="flex items-center gap-1.5">
              <Calendar className="w-3.5 h-3.5 text-text-faint" />
              {date}
            </span>
            {readTime && (
              <span class="flex items-center gap-1.5">
                <Clock className="w-3.5 h-3.5 text-text-faint" />
                {readTime}
              </span>
            )}
          </div>
        </header>

        {readingContext && <aside class="document-reading-context" aria-label="文档位置" data-pagefind-ignore>
          <div><strong>{readingContext.group.title}</strong><span>{readingContext.position ? `${readingContext.position} / ${readingContext.total}` : '按需查阅'}</span></div>
          {(readingContext.note || readingContext.group.description) && <p>{readingContext.note || readingContext.group.description}</p>}
          {currentSlug !== 'physics-simulation-overview' && <a href={`${import.meta.env.BASE_URL}knowledge/`}>回到动力学总览 ↗</a>}
        </aside>}

        {/* Rendered Markdown + KaTeX from <Content /> */}
        <slot />

        {readingContext && (readingContext.previous || readingContext.next) && <nav class="document-adjacent" aria-label="顺序阅读" data-pagefind-ignore>
          {readingContext.previous && <a href={articleHref(readingContext.previous.slug)}><span>上一篇</span>{readingContext.previous.title}</a>}
          {readingContext.next && <a href={articleHref(readingContext.next.slug)}><span>下一篇</span>{readingContext.next.title}</a>}
        </nav>}

        {!readingContext && learningLinks && (learningLinks.prerequisites.length > 0 || learningLinks.nextArticles.length > 0) && (
          <section class="mt-12 pt-8 border-t border-border-subtle grid grid-cols-1 md:grid-cols-2 gap-6" aria-label="文章学习关系">
            {learningLinks.prerequisites.length > 0 && (
              <div>
                <div class="text-[9px] font-mono text-text-faint uppercase tracking-wider mb-3">阅读前建议</div>
                <div class="space-y-2">
                  {learningLinks.prerequisites.map((article) => <a href={`${import.meta.env.BASE_URL}knowledge/${article.slug}/`} class="block text-sm text-text-muted hover:text-accent-primary transition-colors">{article.title}</a>)}
                </div>
              </div>
            )}
            {learningLinks.nextArticles.length > 0 && (
              <div>
                <div class="text-[9px] font-mono text-text-faint uppercase tracking-wider mb-3">接下来阅读</div>
                <div class="space-y-2">
                  {learningLinks.nextArticles.map((article) => <a href={`${import.meta.env.BASE_URL}knowledge/${article.slug}/`} class="block text-sm text-text-muted hover:text-accent-primary transition-colors">{article.title}</a>)}
                </div>
              </div>
            )}
          </section>
        )}

        {(backlinks.length > 0 || outgoingLinks.length > 0 || sources.length > 0) && (
          <section class="mt-12 grid grid-cols-1 gap-5 border-t border-border-subtle pt-8 md:grid-cols-2" aria-label="知识关系与来源">
            {outgoingLinks.length > 0 && (
              <div class="rounded-xl border border-border-subtle bg-surface-card/40 p-5">
                <h2 class="!mt-0 !border-0 !p-0 font-mono !text-xs uppercase tracking-widest text-text-muted">本文引用</h2>
                <div class="mt-3 space-y-2">{outgoingLinks.slice(0, 10).map((link) => <a href={`${import.meta.env.BASE_URL}knowledge/${link.slug}/`} class="block text-sm text-text-secondary hover:text-accent-primary">{link.title}</a>)}</div>
              </div>
            )}
            {backlinks.length > 0 && (
              <div class="rounded-xl border border-border-subtle bg-surface-card/40 p-5">
                <h2 class="!mt-0 !border-0 !p-0 font-mono !text-xs uppercase tracking-widest text-text-muted">被这些页面引用</h2>
                <div class="mt-3 space-y-2">{backlinks.slice(0, 10).map((link) => <a href={`${import.meta.env.BASE_URL}knowledge/${link.slug}/`} class="block text-sm text-text-secondary hover:text-accent-primary">{link.title}</a>)}</div>
              </div>
            )}
            {sources.length > 0 && (
              <div class="rounded-xl border border-border-subtle bg-surface-card/40 p-5 md:col-span-2">
                <h2 class="!mt-0 !border-0 !p-0 font-mono !text-xs uppercase tracking-widest text-text-muted">资料来源</h2>
                <div class="mt-3 flex flex-wrap gap-2">{sources.map((source) => <a href={source.url} target="_blank" rel="noreferrer" class="rounded-lg border border-border-subtle px-3 py-2 text-xs text-text-secondary hover:border-accent-primary/40 hover:text-accent-primary">{source.title}</a>)}</div>
              </div>
            )}
          </section>
        )}

        {/* Tag cloud */}
        <div class="mt-12 pt-8 border-t border-border-subtle flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="px-2.5 py-1 text-[10px] font-mono bg-surface-raised text-text-muted border border-border-subtle rounded">
              #{tag.toUpperCase()}
            </span>
          ))}
        </div>

        {!readingContext && topicContext && (topicContext.previous || topicContext.next) && (
          <nav class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-3" aria-label="专题文章导航">
            {topicContext.previous ? (
              <a href={`${import.meta.env.BASE_URL}knowledge/${topicContext.previous.slug}/`} class="p-4 rounded-xl border border-border-subtle bg-surface-card hover:border-accent-primary/40 transition-colors">
                <span class="block text-[9px] font-mono text-text-faint uppercase tracking-wider">专题上一篇</span>
                <span class="mt-2 block text-sm text-text-secondary hover:text-text-primary">{topicContext.previous.title}</span>
              </a>
            ) : <div />}
            {topicContext.next && (
              <a href={`${import.meta.env.BASE_URL}knowledge/${topicContext.next.slug}/`} class="p-4 rounded-xl border border-border-subtle bg-surface-card hover:border-accent-primary/40 transition-colors md:text-right">
                <span class="block text-[9px] font-mono text-text-faint uppercase tracking-wider">专题下一篇</span>
                <span class="mt-2 block text-sm text-text-secondary hover:text-text-primary">{topicContext.next.title}</span>
              </a>
            )}
          </nav>
        )}

        {/* Related articles — computed at build time, hydrated for hover states */}
        {!readingContext && relatedArticles.length > 0 && (
          <RelatedArticles client:load articles={relatedArticles} lang={lang} />
        )}
        {(historyUrl || rawUrl) && (
          <footer class="mt-10 flex flex-wrap gap-4 border-t border-border-subtle pt-6 font-mono text-[10px] text-text-faint">
            {historyUrl && <a href={historyUrl} target="_blank" rel="noreferrer" class="hover:text-accent-primary">查看 Git 修改历史</a>}
            {rawUrl && <a href={rawUrl} target="_blank" rel="noreferrer" class="hover:text-accent-primary">查看原始 Markdown</a>}
          </footer>
        )}
      </article>
      </main>

      <aside class="document-toc-sidebar">
        <div class="sticky top-24 space-y-4">
          <ReaderActions client:media="(min-width: 1100px)" slug={currentSlug} title={title} category={category} url={canonicalPath} />
          <ArticleToc client:load headings={headings} lang={lang} />
          <a href={`${import.meta.env.BASE_URL}knowledge/graph/?center=${currentSlug}`} class="block rounded-xl border border-border-subtle bg-surface-card/40 px-4 py-3 text-center font-mono text-[10px] uppercase tracking-wider text-text-muted hover:border-accent-primary/30 hover:text-accent-primary">在知识图谱中查看</a>
        </div>
      </aside>
    </div>
  </body>
</html>
