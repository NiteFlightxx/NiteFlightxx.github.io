---
// Shared <head> SEO metadata: description, canonical, Open Graph, Twitter
// Card, and font preconnect. Favicon is NOT emitted here — both Layout.astro
// and ArticleLayout.astro already link their own /favicon.svg, so emitting it
// again would duplicate the tag.
//
// `canonicalPath` is the pathname relative to the site root ('/' or
// '/knowledge/foo/'); it is resolved to an absolute URL for OG/Twitter, which
// require absolute URLs.
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string; // absolute site path, e.g. '/og-image.jpg'
  imageAlt?: string;
  type?: 'website' | 'article';
  canonicalPath?: string;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  imageAlt = SITE.ogImageAlt,
  type = 'website',
  canonicalPath = '/',
} = Astro.props;

const canonical = new URL(canonicalPath, `${SITE.url}/`).href;
const imageUrl = new URL(image, `${SITE.url}/`).href;
---

<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={SITE.author} />

<!-- Per-scheme theme-color: phone browser chrome matches the active skin.
     The inline script below syncs the html class before paint, so the OS
     prefers-color-scheme here picks the right variant on first paint. -->
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#060606" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />

<!-- Apply persisted theme before paint to avoid FOUC. The SPA's
     App.tsx also syncs via useState lazy initializer, but this inline
     script runs synchronously in <head> so the correct palette is
     applied on the very first frame (including article pages, which
     have no React tree). Falls back to the OS prefers-color-scheme
     when no choice has been stored, and persists that default so the
     SPA's lazy initializer and this script agree on subsequent loads. -->
<script is:inline>
  (function () {
    var stored = localStorage.getItem('theme');
    if (stored !== 'light' && stored !== 'dark') {
      stored = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      try { localStorage.setItem('theme', stored); } catch (e) {}
    }
    if (stored === 'light') document.documentElement.classList.add('light-theme');
  })();
</script>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.shortTitle} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
