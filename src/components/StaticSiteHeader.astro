---
import { Menu, Moon, Sun, Search } from 'lucide-react';
import GithubIcon from './GithubIcon';
import BilibiliIcon from './BilibiliIcon';
import Logo from './Logo';
import { MAIN_NAV_ITEMS, mainNavHref } from '../lib/siteNavigation';
import GlobalCommandPalette from './GlobalCommandPalette';

interface Props {
  activeTab: 'projects' | 'knowledge';
}

const { activeTab } = Astro.props;
const baseURL = import.meta.env.BASE_URL;
const navigation = MAIN_NAV_ITEMS.map((item) => ({
  ...item,
  href: mainNavHref(item.id, baseURL),
}));
---

<header class="sticky top-0 z-50 w-full glass-panel border-b border-border-subtle px-6 py-4.5 md:px-12 select-none shadow-[0_8px_30px_rgba(0,0,0,0.45)]">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <a href={baseURL} class="flex items-center gap-3 group" aria-label="NITE 首页">
      <span class="relative w-9 h-9 rounded bg-surface-raised border border-border-strong flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-accent-primary/50">
        <Logo className="w-5 h-5 text-text-secondary transition-colors duration-300 group-hover:text-accent-primary" />
        <div class="absolute inset-0 bg-gradient-to-tr from-brand-accent-orange/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </span>
      <span class="font-display font-black text-base tracking-widest text-text-primary group-hover:text-accent-primary transition-colors duration-300">NITE</span>
    </a>

    <nav aria-label="主导航" class="hidden md:flex items-center gap-1 lg:gap-3 bg-surface-base/80 border border-accent-primary/20 rounded-full px-2 lg:px-3 py-2 shadow-[0_8px_32px_rgba(0,0,0,0.8)]">
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={activeTab === item.id ? 'page' : undefined}
          class:list={[
            'relative px-3 lg:px-6 py-2.5 text-sm lg:text-base font-bold tracking-wider transition-all duration-300 rounded-full flex items-center justify-center',
            activeTab === item.id
              ? 'bg-surface-raised/95 border border-accent-primary/40 text-accent-primary shadow-[0_0_20px_rgba(188,253,73,0.15)]'
              : 'text-text-muted hover:text-text-primary',
          ]}
        >{item.labelZh}</a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <button type="button" data-command-palette-trigger class="flex items-center gap-2 rounded-lg border border-border-subtle bg-surface-base/40 px-3 py-2 text-xs text-text-muted transition-colors hover:border-accent-primary/30 hover:text-text-primary" aria-label="打开全局搜索"><Search className="h-4 w-4" /><span class="hidden lg:inline">搜索</span><kbd class="hidden xl:inline rounded border border-border-subtle px-1.5 py-0.5 font-mono text-[8px] text-text-faint">Ctrl K</kbd></button>
      <a href="https://github.com/NiteFlightxx" target="_blank" rel="noopener noreferrer" class="hidden xl:inline-flex p-2 text-text-muted hover:text-text-primary transition-colors duration-200 rounded-lg hover:bg-surface-raised/20" aria-label="GitHub Profile"><GithubIcon className="w-4 h-4" /></a>
      <a href="https://space.bilibili.com/101356800" target="_blank" rel="noopener noreferrer" class="hidden xl:inline-flex p-2 text-text-muted hover:text-text-primary transition-colors duration-200 rounded-lg hover:bg-surface-raised/20" aria-label="Bilibili 主页"><BilibiliIcon className="w-4 h-4" /></a>
      <button type="button" data-static-theme-toggle class="p-2 text-text-muted hover:text-text-primary transition-colors duration-200 rounded-lg hover:bg-surface-raised/20 cursor-pointer" aria-label="切换主题"><Sun className="w-4 h-4" /></button>
      <span class="hidden lg:block h-4 w-px bg-surface-raised/25"></span>
      <span class="hidden lg:flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-accent-primary/10 border border-accent-primary/20 text-[10px] font-mono text-accent-primary font-medium tracking-wider"><span class="w-1.5 h-1.5 rounded-full bg-accent-primary animate-pulse"></span>UE5.8 编译</span>
    </div>

    <details class="relative md:hidden group">
      <summary class="list-none cursor-pointer p-2 text-text-muted hover:text-text-primary rounded-lg hover:bg-surface-raised/20" aria-label="打开导航菜单"><Menu className="w-5 h-5" /></summary>
      <div class="absolute right-0 top-full mt-4 w-56 glass-panel border border-border-subtle rounded-xl p-3 shadow-2xl flex flex-col gap-1">
        <button type="button" data-command-palette-trigger class="mb-2 flex items-center gap-2 rounded-lg border border-border-subtle px-4 py-2.5 text-left text-sm text-text-secondary"><Search className="h-4 w-4 text-accent-primary" />搜索知识库</button>
        {navigation.map((item) => (
          <a href={item.href} aria-current={activeTab === item.id ? 'page' : undefined} class:list={['block py-2.5 px-4 rounded-lg text-base font-bold tracking-wide', activeTab === item.id ? 'bg-surface-raised text-accent-primary border border-accent-primary/30' : 'text-text-muted hover:text-text-primary hover:bg-surface-raised/20']}>{item.labelZh}</a>
        ))}
        <div class="h-px bg-surface-raised/20 my-2"></div>
        <button type="button" data-static-theme-toggle class="flex items-center gap-2 py-2 px-4 text-sm text-text-secondary hover:text-text-primary" aria-label="切换主题"><Moon className="w-4 h-4" />切换主题</button>
      </div>
    </details>
  </div>
</header>

<GlobalCommandPalette client:load />

<script>
  const sunSVG = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M17.66 6.34l1.41-1.41M4.93 19.07l1.41-1.41"/></svg>';
  const moonSVG = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-static-theme-toggle]');
  const renderThemeButtons = () => {
    const icon = document.documentElement.classList.contains('light-theme') ? sunSVG : moonSVG;
    buttons.forEach((button) => {
      const label = button.closest('details') ? '切换主题' : '';
      button.innerHTML = icon + label;
    });
  };
  renderThemeButtons();
  buttons.forEach((button) => button.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light-theme');
    try { localStorage.setItem('theme', isLight ? 'light' : 'dark'); } catch {}
    renderThemeButtons();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-command-palette-trigger]').forEach((button) => {
    button.addEventListener('click', () => window.dispatchEvent(new Event('nite:open-command-palette')));
  });
</script>
